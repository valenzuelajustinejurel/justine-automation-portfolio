    {
      "parameters": {
        "promptType": "define",
        "text": "=New Application Received:\n\nSubject: {{ $json.Subject }}\nFrom: {{ $json.From }}\nBody: {{ $json.snippet }}\n\nExtract the applicant details, score them, assign a tier, and draft a reply.",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "=You are a hiring assistant for NovaCo. Your job is to screen inbound job applications sent via email.\n\nFor each application, do four things:\n1. Extract the applicant's name, email address, and position they applied for from the email.\n2. Score the candidate from 1 to 10 based on the quality of their cover letter.\n   - 7–10 (strong): Specific experience, measurable results, clear fit, ready to move forward\n   - 4–6 (maybe): Some relevant experience but vague, no clear results, needs more info\n   - 1–3 (pass): No relevant experience, very generic, no effort shown\n   - The score MUST be a number (e.g. 8), not a string (e.g. \"8\"). Never wrap it in quotes.\n3. Assign a tier: \"strong\", \"maybe\", or \"pass\" based on the score.\n4. Write a short reply (2–3 sentences) appropriate for their tier:\n   - strong: Enthusiastic, invite them to schedule a call\n   - maybe: Warm, let them know we'll be in touch\n   - pass: Polite, thank them and let them know we're moving forward with other candidates\n\nAlways respond in valid JSON only. No extra text outside the JSON.\n"
            }
          ]
        },
        "batching": {}
      },
